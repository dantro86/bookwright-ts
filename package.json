{
  "name": "bookwright-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Educational TypeScript + Playwright Test automation framework for API, UI and database testing.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:check": "node scripts/check-config.ts",
    "test": "playwright test",
    "test:framework": "playwright test --project=framework",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "stand:local": "bash scripts/local-stand.sh",
    "report": "allure generate allure-results --output allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "allure": "3.19.1",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "zod": "4.6.5"
  }
}
